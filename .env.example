# Copy to .env. Only needed to deploy or run scripts against X Layer mainnet;
# the local fork setup in the README needs none of this.
RPC_URL=https://rpc.xlayer.tech
# Deployer / fund launcher. Needs a little OKB for gas and tape-out fees, plus BEM for the processor fee.
PRIVATE_KEY=
DEPLOYER=
# Optional: the account scripts/keeper.mjs uses to press Rebalance on mainnet (pays gas only).
KEEPER_KEY=
# Optional: a different RPC for scripts/deweb-publish.mjs uploads.
DEWEB_RPC=
